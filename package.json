{
  "name": "dsh-sidebar-curator",
  "version": "0.1.0",
  "description": "Protocol-based DSH sidebar entry curation with persistent pin choices and fail-open host integration.",
  "license": "MIT",
  "repository": {"type":"git","url":"git+https://github.com/MortisQAQ/dsh-sidebar-curator.git"},
  "homepage":"https://github.com/MortisQAQ/dsh-sidebar-curator#readme",
  "bugs":{"url":"https://github.com/MortisQAQ/dsh-sidebar-curator/issues"},
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts/adapter.mjs",
    "scripts/create-adapter-package.mjs",
    "adapters",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && node scripts/check-workflows.mjs",
    "package:check": "node scripts/check-package.mjs",
    "compatibility:check": "node scripts/check-upstream.mjs",
    "adapter:check": "node scripts/adapter.mjs check",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm run package:check"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "sidebar",
    "plugin",
    "npm"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.2-rc.1 <0.3.0"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^27.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
